{
  "name": "Angeles LipLin School",
  "short_name": "LipLin",
  "description": "School announcements, class suspension alerts and events.",
  "start_url": "./#/m",
  "scope": "./",
  "display": "standalone",
  "orientation": "portrait",
  "background_color": "#f4f6fb",
  "theme_color": "#1d4ed8",
  "icons": [
    { "src": "./icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "./icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "./icon-maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ],
  "shortcuts": [
    { "name": "Class suspensions", "url": "./#/m/alerts", "icons": [{ "src": "./icon-192.png", "sizes": "192x192" }] },
    { "name": "Events", "url": "./#/m/events", "icons": [{ "src": "./icon-192.png", "sizes": "192x192" }] }
  ]
}
